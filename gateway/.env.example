# Preferred production/private-beta authentication: store only hashes on gateway
CNC_CLIENT_TOKEN_HASHES_JSON={"yoshida":"sha256-hex-of-private-client-token"}
CNC_SESSION_SECRET=replace-with-at-least-32-random-characters
CNC_SESSION_TTL_SECONDS=21600
CNC_ALLOW_LEGACY_TOKEN=false

# GPU worker: gateway stores only SHA-256
CNC_WORKER_TOKEN_SHA256=sha256-hex-of-private-worker-token

# Raw-token variables remain supported only for local/dev migration
CNC_CLIENT_TOKENS_JSON={}
CNC_WORKER_TOKEN=

# Limits
CNC_MAX_BODY_BYTES=65536
CNC_RATE_LIMIT=10
CNC_RATE_WINDOW_SECONDS=60
CNC_QUEUE_MAX=8
CNC_REQUEST_TIMEOUT_SECONDS=240

# Public builds can authenticate a random per-install ID instead of embedding a shared secret.
CNC_ALLOW_ANONYMOUS_CLIENTS=true
