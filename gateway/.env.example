# Public gateway client authentication
CNC_CLIENT_TOKENS_JSON={"yoshida":"replace-with-private-bootstrap-token"}
CNC_SESSION_SECRET=replace-with-at-least-32-random-characters
CNC_SESSION_TTL_SECONDS=21600
CNC_ALLOW_LEGACY_TOKEN=false

# Outbound GPU worker authentication
CNC_WORKER_TOKEN=replace-with-separate-random-worker-token

# Limits
CNC_MAX_BODY_BYTES=65536
CNC_RATE_LIMIT=10
CNC_RATE_WINDOW_SECONDS=60
CNC_QUEUE_MAX=8
CNC_REQUEST_TIMEOUT_SECONDS=240
