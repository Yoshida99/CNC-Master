# CNC Master AI provider
CNC_AI_PROVIDER=ollama

# Local Ollama server. Keep it local; public exposure is handled by the gateway later.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=0s
OLLAMA_TIMEOUT_SECONDS=300

# Temporary development gate only. Do not treat a shared APK token as user authentication.
CNC_APP_TOKEN=
